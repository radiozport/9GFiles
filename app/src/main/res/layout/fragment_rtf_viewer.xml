<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurfaceVariant"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="document.rtf" />

            <TextView
                android:id="@+id/tvDocInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:alpha="0.7"
                android:text="Loading…" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTextSize"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_tune"
            android:contentDescription="Toggle text size"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnEdit"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_edit"
            android:contentDescription="Edit document"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnSave"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_save"
            android:contentDescription="Save document"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnCancel"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Cancel editing"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnShare"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            android:contentDescription="Share"
            app:tint="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

    <!-- Loading indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Error message -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <!--
        FORMATTING TOOLBAR — visible only while in edit mode.
        Buttons: Bold · Italic · Underline · Strikethrough
        Active state (when cursor is inside a run with that format) is indicated
        by colourPrimary text + colourPrimaryContainer background, set in code.
    -->
    <HorizontalScrollView
        android:id="@+id/formattingToolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:background="?attr/colorSurfaceVariant"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- Bold -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFmtBold"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:textAllCaps="false"
                android:contentDescription="Bold" />

            <!-- Italic -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFmtItalic"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="I"
                android:textSize="16sp"
                android:textStyle="italic"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:textAllCaps="false"
                android:contentDescription="Italic" />

            <!-- Underline — text span applied in code so the U appears underlined -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFmtUnderline"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="U"
                android:textSize="16sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:textAllCaps="false"
                android:contentDescription="Underline" />

            <!-- Strikethrough — text span applied in code -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFmtStrike"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="S"
                android:textSize="16sp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:textAllCaps="false"
                android:contentDescription="Strikethrough" />

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/colorOutlineVariant" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- VIEW MODE: RTF rendered as HTML in a WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!--
        EDIT MODE: rich-text content in an EditText that scrolls itself.
        Using a plain FrameLayout instead of ScrollView is intentional:
        wrapping a multiline EditText in a ScrollView creates nested-scroll
        conflicts — the ScrollView intercepts touch events before they reach
        the EditText, so scrolling within the editor stalls and every tap
        requires two touches to register.  With FrameLayout the EditText
        manages its own vertical scrolling via android:scrollbars.
    -->
    <FrameLayout
        android:id="@+id/scrollEditor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone">

        <EditText
            android:id="@+id/etEditor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:gravity="top|start"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.5"
            android:inputType="textMultiLine|textCapSentences"
            android:background="@null"
            android:textColor="?attr/colorOnSurface"
            android:textCursorDrawable="@null"
            android:hint="Start typing…"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:scrollbars="vertical"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false" />

    </FrameLayout>

</LinearLayout>
